{
  "name": "fraudlens-ai",
  "version": "1.0.0",
  "description": "Suspicious Transaction Network Intelligence Platform",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/src/server.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm install && npm run build",
    "test": "node --test server/tests/**/*.test.js",
    "install:all": "npm install && cd client && npm install"
  },
  "keywords": ["fraud-detection", "fintech", "graph-analysis"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
